<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The audio-brain API under gunicorn. Install steps are in deploy/README.md; REPO is replaced by the repo's path. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.audiobrain.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>REPO/deploy/run-server.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>REPO/server</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>REPO/server/logs/server.log</string>
    <key>StandardErrorPath</key>
    <string>REPO/server/logs/server.log</string>
</dict>
</plist>
