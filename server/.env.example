# Copy to .env and fill in. Everything is optional unless marked; leaving a key out uses the default shown.

# Database
POSTGRES_DB=audio_brain
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django. DEBUG is off unless set to 1; turn it on only for development. SECRET_KEY is required: the server won't start
# without it (generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))").
SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,.ts.net
DJANGO_LOG_LEVEL=INFO

# The companion app's bearer token; `manage.py api_token` creates it. The API refuses every request while it's unset.
API_TOKEN=

# The Claude MCP server's bearer token (claude_mcp/); its requests count as Claude's. Unset: refused.
MCP_TOKEN=
POSTGRES_RO_PASSWORD=

# Threads the Mixes job builds lists and suggestions on; 1 builds them one at a time.
MIXES_THREADS=6

# gunicorn (deploy/gunicorn.conf.py), read when the server starts under deploy/run-server.sh
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300

# Sources
LASTFM_API_KEY=
LASTFM_USER=
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_COUNTRY=GB
TIDAL_REDIRECT_URI=http://localhost:8765/tidal/callback
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
# YOUTUBE_SET_PLAYLISTS=id1,id2  (public YouTube playlists of sets; defaults to two of yours)
# Sent in the User-Agent header; MusicBrainz asks for a URL or email
API_CONTACT=
# A local MusicBrainz mirror for lookups; empty for musicbrainz.org
MUSICBRAINZ_BASE_URL=
# Its database, for searches (e.g. through kubectl port-forward svc/musicbrainz-db); empty searches musicbrainz.org
MUSICBRAINZ_DATABASE_URL=

# The LLM layer: OpenAI first when both keys are set, unless LLM_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic

# Where and when you listen
LISTENING_TIME_ZONE=Europe/London
LISTENING_COUNTRY=
